{
  "name": "axiovela-math",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Mathematics research, experiment evidence, Lean checks and publication writing.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "desktop:start": "npm run build && electron .",
    "desktop:package:linux": "npm run build && node scripts/package-linux.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:latex": "node scripts/latex-smoke.mjs",
    "test:feedback": "node scripts/feedback-smoke.mjs",
    "test:bridge": "node scripts/bridge-smoke.mjs",
    "test:desktop:packaged": "node scripts/desktop-smoke.mjs --packaged",
    "test:desktop:appimage": "node scripts/desktop-smoke.mjs --appimage",
    "test:desktop:acceptance": "node scripts/desktop-acceptance.mjs",
    "test:lean": "node scripts/lean-smoke.mjs",
    "test:updates": "node --test tests/updates.test.mjs",
    "test:updates:ui": "node scripts/updates-smoke.mjs",
    "release:sign": "node scripts/publish-update.mjs",
    "test:reader": "node scripts/reader-smoke.mjs",
    "test:annotations": "node scripts/annotation-smoke.mjs",
    "test:library": "node scripts/library-polish-smoke.mjs",
    "test:reading": "node scripts/reading-workflow-smoke.mjs",
    "test:connections": "node scripts/connections-smoke.mjs",
    "test:results": "node scripts/result-workspace-smoke.mjs"
  },
  "dependencies": {
    "@citation-js/core": "0.7.21",
    "@citation-js/plugin-bibtex": "0.7.21",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "busboy": "1.6.0",
    "d3-force": "3.0.0",
    "katex": "0.18.5",
    "linkedom": "0.18.13",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "vite": "8.2.2"
  },
  "main": "desktop/main.cjs",
  "productName": "Axiovela Math",
  "author": {
    "name": "Axiovela Math contributors"
  },
  "desktopName": "org.axiovela.math.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/CashBowman/axiovela-math.git"
  },
  "bugs": {
    "url": "https://github.com/CashBowman/axiovela-math/issues"
  },
  "homepage": "https://github.com/CashBowman/axiovela-math#readme"
